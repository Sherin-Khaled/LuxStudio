# All variables are OPTIONAL for local development (npm run dev).
# The app runs fully without a .env file.

# Port the Express + Vite dev server listens on (defaults to 5000)
PORT=5000

# Optional. Without it, form submissions are stored in memory (lost on
# server restart) and `npm run db:push` (drizzle-kit) cannot run.
# Set this in production to persist contact/newsletter submissions.
# DATABASE_URL=postgresql://user:password@localhost:5432/luxstudio

# ─── Admin dashboard (/dashboard) ───
# Required to log into the dashboard at all — if unset, login always fails.
ADMIN_DASHBOARD_PASSWORD=
# Signs the dashboard's login session cookie. If unset, a random secret is
# generated at server startup (logins won't survive a restart). Any long
# random string works — e.g. generate one with `openssl rand -hex 32`.
SESSION_SECRET=

# ─── Company email notifications (SMTP) ───
# Leave SMTP_ENABLED=false (or unset) until you have real SMTP credentials —
# forms keep saving to the dashboard either way; email sending is skipped
# safely and a warning is logged instead of crashing.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COMPANY_EMAIL_TO=

# Example values once Zoho is set up (after buying the domain/hosting):
# SMTP_ENABLED=true
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@mydomain.com
# SMTP_PASS=zoho_app_password
# SMTP_FROM=Lux Studio <hello@mydomain.com>
# COMPANY_EMAIL_TO=hello@mydomain.com
